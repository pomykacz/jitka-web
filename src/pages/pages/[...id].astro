---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages } from '../../lib/content';

export const getStaticPaths = (async () =>
  (await pages()).map((page) => ({ params: { id: page.id }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} draft={page.data.draft}>
  <article>
    <h1>{page.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
